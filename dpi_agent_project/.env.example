# Sovereign DPI-AI Public Agent — Environment Configuration
# Copy this file to .env and customize as needed.
# All values below are defaults used by config.py.

# --- LLM Provider ---
# Options: "ollama" (default), "cloud" (stub), "deterministic" (offline testing)
LLM_PROVIDER=ollama

# --- Ollama Settings ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Cloud LLM Settings (stub — not yet implemented) ---
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=
# CLOUD_LLM_ENDPOINT=

# --- Confidence Threshold ---
# APPLICATION-SPECIFIC PROTOTYPE POLICY — NOT prescribed by NIST AI RMF.
CONFIDENCE_THRESHOLD=0.80

# --- Database ---
# DATABASE_PATH=data_folder/simulated_dpi.db

# --- Audit ---
# AUDIT_DIRECTORY=audit

# --- Prototype Policy Rules ---
# These are PROTOTYPE values, not real government policy.
MINIMUM_LAND_AREA_ACRES=2.0
MINIMUM_CREDIT_SCORE=500
HIGH_IMPACT_CONFIDENCE_THRESHOLD=0.90
