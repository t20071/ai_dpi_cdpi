# Sovereign DPI-AI Public Agent - configuration
# Copy this file to .env (in the repository root) and change what you need.
# Every value shown is the default. Real environment variables override .env.
# .env is git-ignored: put secrets such as GROQ_API_KEY there, never here.

# --- Which AI reads requests ------------------------------------------------
# ollama        a local model through Ollama (data stays on this computer)
# groq          a cloud model through the Groq API (needs GROQ_API_KEY;
#               the citizen's message, never their records, is sent to Groq)
# deterministic keyword rules only, no AI
# The web page lets each visitor pick any option that is available.
LLM_PROVIDER=ollama

# --- Local model (Ollama) ----------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# "auto" picks the largest chat model you have installed.
# Run `dpi-agent models` to see your models, then pin one, e.g.:
#   OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL=auto
# Seconds to wait for one model reply (raise it for big models on CPU)
OLLAMA_TIMEOUT_SECONDS=120
# How long Ollama keeps the model in memory after a request
OLLAMA_KEEP_ALIVE=10m

# --- Cloud model (Groq) ------------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any chat model on your Groq account (`dpi-agent models` lists them).
# qwen/qwen3.8-27b scored best in this project's evals; openai/gpt-oss-20b is faster.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=30
# On a rate limit, wait and retry only if Groq asks for at most this many seconds
GROQ_MAX_RETRY_WAIT_SECONDS=10

# --- Risk and policy thresholds ---------------------------------------------
# Application-specific PROTOTYPE values, not prescribed by NIST AI RMF and
# not real government policy.
CONFIDENCE_THRESHOLD=0.80
HIGH_IMPACT_CONFIDENCE_THRESHOLD=0.90
MINIMUM_LAND_AREA_ACRES=2.0
MINIMUM_CREDIT_SCORE=500

# --- Web server ----------------------------------------------------------------
# AI requests per minute per visitor (0 = no limit). Protects your Groq quota.
RATE_LIMIT_PER_MINUTE=10
# Host names the server answers to: loopback names locally, any ("*") on Vercel.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Reference clock -----------------------------------------------------------
# Consent expiry is checked against the current time, and the dataset has
# fixed valid_until dates (latest 2027-08-15). Pin "now" to keep the demo
# scenarios reproducible after those dates pass.
# REFERENCE_TIME=2026-10-01T00:00:00+00:00

# --- Paths -----------------------------------------------------------------------
# Where source CSVs (DPI_DATA_DIR/raw) and runtime files live.
# Relative paths are taken from the repository root.
# DPI_DATA_DIR=data
# DPI_RUNTIME_DIR=data/runtime
